# ===== 配置模板：复制本文件为 .env 后再修改 =====
# Windows 复制命令： copy .env.example .env

# ---------- 数据库配置 ----------
# 方式A（默认，零安装练习）：SQLite，文件会自动生成在 data/warehouse 目录下
DB_URL=sqlite:///data/warehouse/warehouse.db

# 方式B（老师技术栈要求）：MySQL，先在 MySQL 里建库：CREATE DATABASE dw_demo DEFAULT CHARSET utf8mb4;
# DB_URL=mysql+pymysql://root:你的密码@localhost:3306/dw_demo?charset=utf8mb4

# ---------- 大模型配置（NL2SQL 模块使用）----------
# DeepSeek 示例：注册 https://platform.deepseek.com 后充值/领取免费额度，创建 API Key
LLM_API_KEY=请在这里填你的API_KEY
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat

# 通义千问（百炼）示例，换用则改成下面两行：
# LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# LLM_MODEL=qwen-plus
